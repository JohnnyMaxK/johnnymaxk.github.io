---
// CV on request (Parcours page). The site is static: no form, a mailto link only.
import { t, type Lang } from '../i18n/ui';
import { contact } from '../site.config';
interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="cv-request" aria-labelledby="cv-titre" id="cv">
  <h2 id="cv-titre">{t(lang, 'cv.title')}</h2>
  <p>{t(lang, 'cv.text')}</p>
  <p><a href={`mailto:${contact.email}?subject=${encodeURIComponent(t(lang, 'cv.subject'))}`}>{t(lang, 'cv.link')} {contact.email}</a></p>
</section>
