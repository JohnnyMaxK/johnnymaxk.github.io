---
import { t, type Lang } from '../i18n/ui';
interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site">
  <div class="wrap">
    <span>© {year} {t(lang, 'site.name')}</span>
    <a href="/mentions-legales/">{t(lang, 'footer.legal')}</a>
    <a href="/rss.xml">{t(lang, 'footer.rss')}</a>
    <span>{t(lang, 'footer.notrack')}</span>
  </div>
</footer>
